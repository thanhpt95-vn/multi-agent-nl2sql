# Required for the default model configuration.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional provider keys. Uncomment only when selecting these providers.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional Spider database location.
# SPIDER_DATABASE_DIR=/absolute/path/to/spider_data/database

# Optional local LLM configuration.
# USE_LOCAL_LLM=false
# LOCAL_LLM_MODEL=openai/qwen-2.5-coder-14b
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
